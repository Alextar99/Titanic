cat(sprintf("Observaciones válidas     : %d\n",  nrow(train_clust_sc)))
cat("Se trabaja con variables estandarizadas (Z-score).\n")


# ------------------------------------------------------------------
# f.2) K-MEANS: selección del número óptimo de clústeres
# ------------------------------------------------------------------
set.seed(101)

# Método del codo (WCSS)
wcss <- sapply(1:10, function(k)
  kmeans(train_clust_sc, centers = k, nstart = 50)$tot.withinss)

p_elbow <- ggplot(data.frame(k = 1:10, WCSS = wcss), aes(x = k, y = WCSS)) +
  geom_point(color = "#2C7BB6", size = 2.5) +
  geom_line(color = "#2C7BB6", linewidth = 1) +
  scale_x_continuous(breaks = 1:10) +
  labs(title    = "Método del Codo — WCSS (K-Means)",
       subtitle = "El punto de inflexión indica el K óptimo",
       x = "Número de clústeres (K)", y = "WCSS") + theme_hp
print(p_elbow)

# Método de la silueta
dist_clust <- dist(train_clust_sc)
sil_prom   <- sapply(2:8, function(k) {
  km_tmp <- kmeans(train_clust_sc, centers = k, nstart = 50)
  mean(silhouette(km_tmp$cluster, dist_clust)[, 3])
})
k_opt <- (2:8)[which.max(sil_prom)]
cat(sprintf("\nK óptimo (silueta máxima): K = %d\n", k_opt))

p_sil_sel <- ggplot(data.frame(k = 2:8, Silueta = sil_prom), aes(x = k, y = Silueta)) +
  geom_point(color = "#D7191C", size = 2.5) +
  geom_line(color = "#D7191C", linewidth = 1) +
  geom_vline(xintercept = k_opt, linetype = "dashed", color = "gray40") +
  scale_x_continuous(breaks = 2:8) +
  labs(title    = "Método de la Silueta — K-Means",
       subtitle = sprintf("K = %d ofrece la mayor anchura media de silueta", k_opt),
       x = "Número de clústeres (K)", y = "Anchura media de silueta") + theme_hp
print(p_sil_sel)


# ------------------------------------------------------------------
# f.3) K-MEANS FINAL
# ------------------------------------------------------------------
set.seed(101)
km_final <- kmeans(train_clust_sc, centers = k_opt, nstart = 50)

cat(sprintf("\nK-Means con K = %d:\n", k_opt))
cat("  Tamaño de cada clúster:\n")
print(table(km_final$cluster))
cat(sprintf("  BSS/TSS = %.1f%%\n", 100 * km_final$betweenss / km_final$totss))

