# ------------------------------------------------------------------
# d.1) Selección y preparación de variables cuantitativas
# ------------------------------------------------------------------
pca_vars <- c("LotFrontage","LotArea","GrLivArea","TotalBsmtSF",
              "FlrSF_1st","FlrSF_2nd","GarageArea","WoodDeckSF",
              "OpenPorchSF","TotalBaths","TotRmsAbvGrd","Fireplaces",
              "HouseAge","RemodAge","BedroomAbvGr","KitchenAbvGr")

idx_pca    <- complete.cases(train[, pca_vars])
train_pca  <- train[idx_pca, pca_vars]

cat(sprintf("\nVariables seleccionadas para PCA: %d\n",  length(pca_vars)))
cat(sprintf("Observaciones válidas (sin NA)   : %d\n\n", nrow(train_pca)))

cat("Medias de las variables (antes de estandarizar):\n")
print(round(apply(train_pca, 2, mean), 2))
cat("\nVarianzas de las variables (antes de estandarizar):\n")
print(round(apply(train_pca, 2, var), 2))
cat("\nLas escalas son muy distintas → se estandarizan a media 0 y DT 1.\n")


# ------------------------------------------------------------------
# d.2) Ejecución del PCA
# ------------------------------------------------------------------
pca_out <- prcomp(train_pca, center = TRUE, scale. = TRUE)

cat("\nCargas (loadings) de las 4 primeras componentes:\n")
print(round(pca_out$rotation[, 1:4], 3))


# ------------------------------------------------------------------
# d.3) Varianza explicada y criterios de selección
# ------------------------------------------------------------------
pca_var  <- pca_out$sdev^2
pve      <- pca_var / sum(pca_var)
pve_acum <- cumsum(pve)

tabla_pve <- data.frame(
  CP            = paste0("PC", seq_along(pve)),
  Autovalor     = round(pca_var, 4),
  PVE           = round(pve * 100, 2),
  PVE_Acumulada = round(pve_acum * 100, 2)
)
cat("\n--- Varianza explicada por componente ---\n")
print(tabla_pve)

n_kaiser <- sum(pca_var > 1)
n_80     <- which(pve_acum >= 0.80)[1]
cat(sprintf("\nCriterio de Kaiser (autovalor > 1)    : %d componentes\n", n_kaiser))
cat(sprintf("Criterio del 80%% de varianza acumulada: %d componentes (%.1f%%)\n",
            n_80, pve_acum[n_80] * 100))

# Scree plot
p_scree_pca <- fviz_eig(
  pca_out, addlabels = TRUE, ylim = c(0, 45),
  barfill = "#2C7BB6", barcolor = "#2C7BB6", linecolor = "#D7191C"
) +
  geom_hline(yintercept = 100 / length(pca_vars),
             linetype = "dashed", color = "#1A9641", linewidth = 0.8) +
  labs(title    = "Scree Plot — Varianza Explicada por Componente Principal",
       subtitle = sprintf("Kaiser: %d CPs  |  80%% varianza: %d CPs", n_kaiser, n_80),
       x = "Componente principal", y = "% varianza explicada") + theme_hp
print(p_scree_pca)

# Gráficos PVE individual y acumulada (base R)
par(mfrow = c(1, 2))
plot(pve, type = "b", pch = 19, col = "#2C7BB6",
     xlab = "CP", ylab = "PVE", main = "PVE por componente", ylim = c(0, 1))
abline(h = 1 / length(pca_vars), col = "#1A9641", lty = 2)
plot(pve_acum, type = "b", pch = 19, col = "#D7191C",
     xlab = "CP", ylab = "PVE acumulada", main = "PVE acumulada", ylim = c(0, 1))
abline(h = 0.80, col = "#1A9641", lty = 2, lwd = 2)
par(mfrow = c(1, 1))


