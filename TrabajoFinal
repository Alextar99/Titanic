  geom = "point", pointsize = 1.2, alpha = 0.40,
  ellipse.type = "convex", ggtheme = theme_hp
) +
  labs(title    = sprintf("K-Means (K = %d) — Proyección en el espacio PCA", k_opt),
       subtitle = sprintf("BSS/TSS = %.1f%%", 100 * km_final$betweenss / km_final$totss))
print(p_km)

# Gráfico de silueta
sil_final <- silhouette(km_final$cluster, dist_clust)
p_sil_km  <- fviz_silhouette(sil_final) +
  labs(title    = sprintf("Silueta — K-Means (K = %d)", k_opt),
       subtitle = sprintf("Anchura media = %.3f", mean(sil_final[, 3]))) + theme_hp
print(p_sil_km)


