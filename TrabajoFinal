df_comp <- bind_rows(
  train_pre_outliers %>% dplyr::select(all_of(vars_plot)) %>% mutate(Fase = "1. Original"),
  train              %>% dplyr::select(all_of(vars_plot)) %>% mutate(Fase = "2. Post-Imputación k-NN")
) %>% pivot_longer(cols = -Fase, names_to = "Variable", values_to = "Valor")

p_comp <- ggplot(df_comp, aes(x = Fase, y = Valor, fill = Fase)) +
  geom_boxplot(alpha = 0.7, outlier.alpha = 0.5, outlier.size = 1) +
