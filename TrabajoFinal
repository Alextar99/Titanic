  scale_fill_manual(values = c("1. Original" = "#FC8D59", "2. Post-Imputación k-NN" = "#74ADD1")) +
  labs(title    = "Efecto del tratamiento de outliers (Boxplot Ajustado + VIM::kNN)",
       subtitle = "5 vecinos más similares según distancia de Gower",
       x = NULL, y = "Valor") +
  theme_hp +
  theme(legend.position = "none",
        axis.text.x     = element_text(angle = 15, hjust = 1, face = "bold"),
        strip.text      = element_text(size = 11, face = "bold", color = "#2C7BB6"))
print(p_comp)
cat("✓ Tratamiento de outliers completado.\n")


# --- PASO 8: Estandarización Z-Score --------------------------
cat("\nPASO 8 — Estandarización Z-Score (dlookr)\n")
vars_escalar <- c("GrLivArea","LotArea","TotalBsmtSF","TotalSF")
for (v in vars_escalar)
  train[[paste0(v, "_z")]] <- dlookr::transform(train[[v]], method = "zscore")


# --- PASO 9: One Hot Encoding ---------------------------------
cat("\nPASO 9 — One Hot Encoding (fastDummies)\n")
train <- dummy_cols(train,
                    select_columns      = c("Neighborhood","BldgType","SaleCondition"),
                    remove_first_dummy  = TRUE,
                    remove_selected_columns = FALSE)
cat("Variables dummy creadas exitosamente.\n")


# --- PASO 10: Detección de Inconsistencias Lógicas -----------
cat("\n--- Verificación de Reglas Lógicas (post-imputación) ---\n")
reglas <- editset(c("SalePrice > 0","LotArea > 0","TotalBsmtSF >= 0",
                    "GrLivArea >= FlrSF_1st","YearBuilt <= YrSold"))

train_chk <- train %>%
  mutate(YrSold = as.integer(as.character(YrSold))) %>%
  dplyr::select(SalePrice, LotArea, TotalBsmtSF, GrLivArea, FlrSF_1st, YearBuilt, YrSold)

violaciones <- violatedEdits(reglas, train_chk)
print(summary(violaciones))

if (sum(violaciones, na.rm = TRUE) > 0) {
  cat("¡Inconsistencias detectadas! Corrigiendo con k-NN...\n")
  errores_loc  <- localizeErrors(reglas, train_chk, method = "mip")$adapt
  cols_eval    <- colnames(errores_loc)
  for (col in cols_eval) {
    filas_err <- which(errores_loc[, col])
    if (length(filas_err) > 0) {
      train[[col]][filas_err] <- NA
      cat(sprintf(" -> NA en '%s' (filas: %s)\n", col, paste(filas_err, collapse = ", ")))
    }
  }
  train <- suppressWarnings(VIM::kNN(train, variable = cols_eval, k = 5, imp_var = FALSE))
  train <- train %>%
    mutate(TotalSF = TotalBsmtSF + FlrSF_1st + FlrSF_2nd,
           QualSF  = as.integer(OverallQual) * TotalSF)
  cat("✓ Inconsistencias corregidas.\n")
} else {
  cat("✓ Datos lógicamente consistentes.\n")
}


