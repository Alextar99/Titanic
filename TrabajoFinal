print(p_justif)

# Detección y NAlización de outliers
diag_out <- do.call(rbind, lapply(out_vars, function(v) {
  x       <- train[[v]]
  bx      <- robustbase::adjboxStats(x[!is.na(x)])
  is_out  <- !is.na(x) & (x < bx$fence[1] | x > bx$fence[2])
  n_out   <- sum(is_out)
  train[[v]][is_out] <<- NA
  data.frame(Variable = v,
             Lim_Inf  = round(bx$fence[1], 1),
             Lim_Sup  = round(bx$fence[2], 1),
             N_out    = n_out,
             Pct_out  = round(100 * n_out / sum(!is.na(x)), 1))
})) %>% arrange(desc(Pct_out))
print(diag_out, row.names = FALSE)


# --- PASO 7: Imputación k-NN ----------------------------------
cat("\nPASO 7 — Imputación k-NN (VIM, k = 5, distancia de Gower)\n")
train <- VIM::kNN(train, variable = out_vars, k = 5, imp_var = FALSE)
train <- train %>%
  mutate(TotalSF = TotalBsmtSF + FlrSF_1st + FlrSF_2nd,
